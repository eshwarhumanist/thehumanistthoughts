<%- include('../partials/head', { title: article ? 'Edit Article' : 'New Article' }) %>

<div class="layout" style="max-width: 1200px;">
  <main class="content" style="width:100%;">
    <div class="form-page">
      <h2><%= article ? 'Edit Article' : 'New Article' %></h2>

      <% if (errors.length > 0) { %>
        <div class="errors">
          <ul style="margin:0; padding-left: 1.1rem;">
            <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form method="POST"
            action="<%= article ? '/admin/articles/' + article.id + '?_method=PUT' : '/admin/articles' %>"
            enctype="multipart/form-data">

        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= formData.title || '' %>" required maxlength="200">

        <label for="genre_id">Genre</label>
        <select id="genre_id" name="genre_id">
          <option value="">— No genre —</option>
          <% genres.forEach(function(g) { %>
            <option value="<%= g.id %>" <%= (formData.genre_id == g.id) ? 'selected' : '' %>><%= g.name %></option>
          <% }) %>
        </select>

        <label for="summary">Short Summary (shown on home page)</label>
        <textarea id="summary" name="summary" maxlength="400" style="min-height:80px;"><%= formData.summary || '' %></textarea>

        <label for="cover_image">Cover Image</label>
        <% if (article && article.cover_image) { %>
          <img class="current-cover" src="<%= article.cover_image %>" alt="Current cover">
          <label style="text-transform:none; font-size:0.85rem;"><input type="checkbox" name="remove_cover_image" style="width:auto;"> Remove current image</label>
        <% } %>
        <input type="file" id="cover_image" name="cover_image" accept=".png,.jpg,.jpeg,.webp,.gif">

        <label for="body">Article Content</label>
        <textarea id="body" name="body" class="body-field" required><%= formData.body || '' %></textarea>

        <div class="actions">
          <button type="submit"><%= article ? 'Save Changes' : 'Publish Article' %></button>
          <a href="/admin" class="btn btn-outline">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../partials/foot') %>
