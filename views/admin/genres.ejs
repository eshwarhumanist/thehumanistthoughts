<%- include('../partials/head', { title: 'Manage Genres' }) %>

<div class="layout" style="max-width: 900px;">
  <main class="content" style="width:100%;">
    <div class="form-page">
      <h2>Manage Genres</h2>

      <% if (error) { %>
        <div class="errors"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/genres" style="display:flex; gap:0.75rem; align-items:flex-end;">
        <div style="flex:1;">
          <label for="name">New Genre Name</label>
          <input type="text" id="name" name="name" maxlength="60" required>
        </div>
        <button type="submit" style="margin-bottom: 0;">Add</button>
      </form>

      <table class="admin-table" style="margin-top:1.5rem;">
        <thead>
          <tr><th>Genre</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% genres.forEach(function(g) { %>
            <tr>
              <td><%= g.name %></td>
              <td>
                <form method="POST" action="/admin/genres/<%= g.id %>?_method=DELETE" onsubmit="return confirm('Delete this genre? Articles in it will become uncategorized.');">
                  <button type="submit" class="btn-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<%- include('../partials/foot') %>
