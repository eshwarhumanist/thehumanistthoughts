<%- include('../partials/head', { title: 'Admin Dashboard' }) %>

<div class="layout" style="max-width: 1200px;">
  <main class="content" style="width:100%;">
    <div class="admin-header">
      <h2 style="margin:0;">Manage Articles</h2>
      <a href="/admin/articles/new" class="btn">+ New Article</a>
    </div>

    <% if (articles.length === 0) { %>
      <div class="empty-state">
        <p>You haven't published anything yet.</p>
      </div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Published</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% articles.forEach(function(a) { %>
            <tr>
              <td><a href="/article/<%= a.slug %>" target="_blank"><%= a.title %></a></td>
              <td><%= a.genre_name || '—' %></td>
              <td><%= new Date(a.created_at).toDateString() %></td>
              <td class="row-actions">
                <a href="/admin/articles/<%= a.id %>/edit" class="btn btn-outline">Edit</a>
                <form method="POST" action="/admin/articles/<%= a.id %>?_method=DELETE" onsubmit="return confirm('Delete this article permanently? This cannot be undone.');">
                  <button type="submit" class="btn-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</div>

<%- include('../partials/foot') %>
