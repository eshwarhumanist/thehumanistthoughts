<%- include('partials/head', { title: article.title }) %>

<div class="layout">
  <%- include('partials/sidebar', { activeGenre: article.genre_slug }) %>

  <main class="content">
    <article class="full-article">
      <% if (article.cover_image) { %>
        <img class="cover" src="<%= article.cover_image %>" alt="<%= article.title %>">
      <% } %>
      <div class="meta">
        <% if (article.genre_name) { %><span class="genre-tag"><%= article.genre_name %></span><% } %>
        Published <%= new Date(article.created_at).toDateString() %>
        <% if (article.updated_at !== article.created_at) { %> &middot; Updated <%= new Date(article.updated_at).toDateString() %><% } %>
      </div>
      <h2><%= article.title %></h2>
      <div class="body-text"><%= article.body %></div>
    </article>

    <section class="comments" id="comments">
      <h3>Comments (<%= comments.length %>)</h3>

      <% if (comments.length === 0) { %>
        <p style="color: var(--ink-soft); font-family: 'Segoe UI', Arial, sans-serif;">Be the first to share your thoughts.</p>
      <% } %>

      <% comments.forEach(function(c) { %>
        <div class="comment">
          <span class="comment-author"><%= c.author_name %></span>
          <span class="comment-date"><%= new Date(c.created_at).toLocaleString() %></span>
          <p><%= c.body %></p>
        </div>
      <% }) %>

      <% if (errors.length > 0) { %>
        <div class="errors">
          <ul style="margin:0; padding-left: 1.1rem;">
            <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form class="comment-form" method="POST" action="/article/<%= article.slug %>/comments">
        <label for="author_name" style="display:block; font-size:0.8rem; text-transform:uppercase; color: var(--ink-soft); margin-bottom:0.3rem;">Your name</label>
        <input type="text" id="author_name" name="author_name" value="<%= formData.author_name || '' %>" maxlength="80" required>
        <label for="body" style="display:block; font-size:0.8rem; text-transform:uppercase; color: var(--ink-soft); margin-bottom:0.3rem;">Your comment</label>
        <textarea id="body" name="body" maxlength="2000" required><%= formData.body || '' %></textarea>
        <button type="submit">Post Comment</button>
      </form>
    </section>
  </main>
</div>

<%- include('partials/foot') %>
